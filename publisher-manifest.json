800;line-height: 1;margin-bottom: 18px;letter-spacing: -2px}\n@media (max-width: 720px) { .steps {grid-template-columns: 1fr} }\n\n/* 服务特性 */\n.features-grid {display: grid;grid-template-columns: repeat(2, 1fr);gap: 20px}\n.feature-item {padding: 26px;border-left: 3px solid #b6ff5c;background: #101010;border-radius: 0 16px 16px 0}\n.feature-item h3 {font-size: 16px;margin-bottom: 8px}\n.feature-item p {color: #999;font-size: 14px}\n@media (max-width: 720px) { .features-grid {grid-template-columns: 1fr} }\n\n/* FAQ 双栏问答 */\n.faq-grid {display: grid;grid-template-columns: 1fr 1fr;gap: 24px 40px}\n.faq-item {border-bottom: 1px solid #1a1a1a;padding-bottom: 18px}\n.faq-q {color: #fff;font-weight: 600;font-size: 16px;margin-bottom: 10px;display: flex;gap: 12px}\n.faq-q::before {content: \"Q\";color: #b6ff5c;font-family: monospace;font-weight: 700}\n.faq-a {color: #b0b0b0;font-size: 14px;padding-left: 26px;position: relative}\n.faq-a::before {content: \"A\";position: absolute;left: 0;color: #555;font-family: monospace;font-weight: 700}\n@media (max-width: 720px) { .faq-grid {grid-template-columns: 1fr;gap: 20px} }\n\n/* 页脚 */\nfooter {border-top: 1px solid #151515;padding: 48px 0 60px;color: #555;font-size: 13px}\nfooter .ftop {display: flex;justify-content: space-between;align-items: flex-start;flex-wrap: wrap;gap: 20px;margin-bottom: 24px}\nfooter .brand-mark {font-size: 20px;color: #fff;font-weight: 800;letter-spacing: -1px}\nfooter .brand-mark span {color: #b6ff5c}\nfooter .links {display: flex;gap: 22px}\nfooter .links a:hover {color: #b6ff5c}\n</style><div class=\"wrap\">\n\n<header class=\"hero\">\n<nav class=\"anchor-bar\">\n<a href=\"#plans\">套餐价格</a>\n<a href=\"#howto\">上手指南</a>\n<a href=\"#features\">服务特性</a>\n<a href=\"#devices\">支持设备</a>\n<a href=\"#faq\">常见问题</a>\n</nav>\n<div class=\"narrow\">\n<h1>闪电<span>熊</span></h1>\n<p class=\"lead\">为个人、玩家与小型团队设计的网络加速订阅。三个档位,按需选择,激活即用。</p>\n<div class=\"meta\">\n<div><span>3</span>主要套餐档位</div>\n<div><span>2</span>付费周期可选</div>\n<div><span>7×24</span>工单入口</div>\n</div>\n</div>\n</header>\n\n<main>\n\n<section id=\"plans\">\n<h2>套餐<span class=\"dot\">.</span></h2>\n<p class=\"section-sub\">月付与年付两种周期,所有套餐在购买后即时开通。下表为横向对比,便于选择最适合自己的档位。</p>\n\n<table class=\"plans-table\">\n<thead>\n<tr>\n<th>项目</th>\n<th>基础版</th>\n<th class=\"featured-col\">旗舰版 · 推荐</th>\n<th>团队版</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>\n<div class=\"plan-name\">基础版</div>\n<div class=\"plan-price\">¥15<small>/月</small></div>\n<div class=\"plan-price\">年付 ¥150/年</div>\n</td>\n<td>\n<ul>\n<li>每月 100GB 高速流量</li>\n<li>支持 3 台设备同时在线</li>\n<li>解锁基础流媒体</li>\n<li>普通线路节点池</li>\n</ul>\n</td>\n<td class=\"featured-cell\">\n<ul>\n<li>每月 300GB 高速流量</li>\n<li>支持 5 台设备同时在线</li>\n<li>全节点原生流媒体解锁</li>\n<li>IPLC 专线游戏加速优化</li>\n<li>7×24 优先工单支持</li>\n</ul>\n</td>\n<td>\n<ul>\n<li>每月 1000GB 高速流量</li>\n<li>支持 20 台设备同时在线</li>\n<li>VIP 专属高带宽节点</li>\n<li>支持企业定制路由</li>\n<li>专属客户经理服务</li>\n</ul>\n</td>\n</tr>\n<tr>\n<td><strong>节点线路</strong></td>\n<td>共享节点池</td>\n<td class=\"featured-cell\">专线 + 优质节点</td>\n<td>独立 VIP 节点</td>\n</tr>\n<tr>\n<td><strong>设备数</strong></td>\n<td>3 台</td>\n<td class=\"featured-cell\">5 台</td>\n<td>20 台</td>\n</tr>\n<tr>\n<td><strong>月流量</strong></td>\n<td>100GB</td>\n<td class=\"featured-cell\">300GB</td>\n<td>1000GB</td>\n</tr>\n<tr>\n<td><strong>工单响应</strong></td>\n<td>工作时段</td>\n<td class=\"featured-cell\">7×24 优先</td>\n<td>专属经理对接</td>\n</tr>\n</tbody>\n<tfoot>\n<tr>\n<td>所有套餐价格均以人民币计费。年付为一次性预付,折算后比月付节省约两个月费用。</td>\n</tr>\n</tfoot>\n</table>\n</section>\n\n<section id=\"howto\">\n<h2>上手指南<span class=\"dot\">.</span></h2>\n<p class=\"section-sub\">注册、下单、导入节点,三步即可完成全部设置。</p>\n<div class=\"steps\">\n<div class=\"step\">\n<div class=\"num\">01</div>\n<h3>注册账户</h3>\n<p>使用邮箱注册闪电熊账户,完成验证即可进入用户中心。账户信息可随时在个人资料中修改。</p>\n</div>\n<div class=\"step\">\n<div class=\"num\">02</div>\n<h3>选择套餐</h3>\n<p>在套餐页选择基础版、旗舰版或团队版,确定月付或年付,完成支付后订阅自动激活。</p>\n</div>\n<div class=\"step\">\n<div class=\"num\">03</div>\n<h3>导入并连接</h3>\n<p>在用户中心复制对应客户端的订阅链接,粘贴到所选设备的客户端中即可建立连接。</p>\n</div>\n</div>\n</section>\n\n<section id=\"features\">\n<h2>服务特性<span class=\"dot\">.</span></h2>\n<p class=\"section-sub\">围绕订阅者日常使用场景设计的功能点。</p>\n<div class=\"features-grid\">\n<div class=\"feature-item\">\n<h3>多设备并行</h3>\n<p>不同套餐对应不同设备并发数,可在电脑、手机、平板及路由器之间同时连接,适合家庭与小团队共用。</p>\n</div>\n<div class=\"feature-item\">\n<h3>流媒体适配</h3>\n<p>节点覆盖常见流媒体平台所需的地址库,旗舰版起支持原生解锁,减少手动切换节点的操作。</p>\n</div>\n<div class=\"feature-item\">\n<h3>游戏加速通道</h3>\n<p>旗舰版内置 IPLC 专线节点,面向主机与端游的联机对战优化,降低延迟波动与丢包率。</p>\n</div>\n<div class=\"feature-item\">\n<h3>流量统计</h3>\n<p>用户中心实时显示当月已用流量与剩余流量,支持按周期切换,便于预估后续用量。</p>\n</div>\n<div class=\"feature-item\">\n<h3>工单与售后</h3>\n<p>基础与团队版在工作时段响应,旗舰版提供 7×24 优先通道,团队版配置专属客户经理。</p>\n</div>\n<div class=\"feature-item\">\n<h3>节点调度</h3>\n<p>客户端内置智能调度,根据延迟与负载自动选择合适节点,也可手动指定区域。</p>\n</div>\n</div>\n</section>\n\n<section id=\"devices\">\n<h2>支持设备<span class=\"dot\">.</span></h2>\n<p class=\"section-sub\">订阅链接兼容主流客户端,可跨平台共用同一账户。</p>\n<div class=\"devices\">\n<div class=\"card\">\n<div class=\"ico\">W</div>\n<h3>Windows</h3>\n<p>覆盖主流桌面客户端,支持订阅链接导入与自动更新节点信息。</p>\n</div>\n<div class=\"card\">\n<div class=\"ico\">M</div>\n<h3>macOS</h3>\n<p>提供对应版本,使用相同账户即可在苹果电脑上登录使用。</p>\n</div>\n<div class=\"card\">\n<div class=\"ico\">i</div>\n<h3>iOS / iPad</h3>\n<p>支持通过标准订阅方式添加节点配置,在设置完成后即可使用。</p>\n</div>\n<div class=\"card\">\n<div class=\"ico\">A</div>\n<h3>Android</h3>\n<p>支持主流安卓客户端,可使用扫码或链接方式快速导入。</p>\n</div>\n</div>\n</section>\n\n<section id=\"faq\">\n<h2>常见问题<span class=\"dot\">.</span></h2>\n<p class=\"section-sub\">订阅与使用过程中常见的问题与简要说明。</p>\n<div class=\"faq-grid\">\n<div class=\"faq-item\">\n<div class=\"faq-q\">三档套餐的主要区别是什么?</div>\n<div class=\"faq-a\">差异体现在月流量上限、同时在线设备数、节点类型与售后响应速度。建议个人轻度使用选择基础版,经常看流媒体或玩游戏可选旗舰版,小型团队与多设备共享则考虑团队版。</div>\n</div>\n<div class=\"faq-item\">\n<div class=\"faq-q\">月付和年付怎么选更划算?</div>\n<div class=\"faq-a\">年付为一年一次性预付,价格相当于十个月的月付。若计划长期使用,年付更划算;若只是短期尝鲜,建议先以月付试用,后续可在用户中心切换周期。</div>\n</div>\n<div class=\"faq-item\">\n<div class=\"faq-q\">订阅链接能在多少个客户端上使用?</div>\n<div class=\"faq-a\">同时在线设备数量取决于所选套餐:基础版 3 台,旗舰版 5 台,团队版 20 台。同一时间超出设备数会被服务端拒绝新的连接请求。</div>\n</div>\n<div class=\"faq-item\">\n<div class=\"faq-q\">套餐内的流量每月会清零吗?</div>\n<div class=\"faq-a\">是的,月付与年付套餐的流量均按自然月计算,每月 1 日 0 点重置。年付用户同样每月重置,建议在月初规划使用量。</div>\n</div>\n<div class=\"faq-item\">\n<div class=\"faq-q\">可以从基础版升级到旗舰版吗?</div>\n<div class=\"faq-a\">可以在任意时间升级。用户中心提供套餐变更入口,差价按剩余天数折算,完成后新套餐权益即时生效。</div>\n</div>\n<div class=\"faq-item\">\n<div class=\"faq-q\">遇到连接问题如何获取帮助?</div>\n<div class=\"faq-a\">可在用户中心提交工单,描述问题与设备类型。基础版在工作时段响应,旗舰版为 7×24 优先处理,团队版则由专属经理跟进。</div>\n</div>\n<div class=\"faq-item\">\n<div class=\"faq-q\">节点数量与地区覆盖如何?</div>\n<div class=\"faq-a\">各套餐均对应一组节点池。基础版走共享节点,旗舰版包含 IPLC 专线,团队版可获得独立 VIP 节点与路由定制。具体地区以客户端中显示列表为准。</div>\n</div>\n<div class=\"faq-item\">\n<div class=\"faq-q\">团队版是否支持多人分开计费?</div>\n<div class=\"faq-a\">团队版按单一账户绑定使用,支持最多 20 台设备并行。若希望按人拆分账单,需要分别购买多个账户,目前未提供合并开票服务。</div>\n</div>\n</div>\n</section>\n\n</main>\n\n<footer>\n<div class=\"ftop\">\n<div class=\"brand-mark\">闪电<span>熊</span></div>\n<nav class=\"links\">\n<a href=\"#plans\">套餐</a>\n<a href=\"#howto\">指南</a>\n<a href=\"#features\">特性</a>\n<a href=\"#faq\">问题</a>\n</nav>\n</div>\n<p>闪电熊 · 按需选择,按量使用。套餐价格以页面展示为准,具体权益以激活后用户中心配置信息为准。</p>\n</footer>\n\n</div>",
